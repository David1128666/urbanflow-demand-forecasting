# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DEMAND_TOPIC=urbanflow-demand-events
KAFKA_GROUP_ID=urbanflow-realtime-group

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=urbanflow
MYSQL_PASSWORD=urbanflow_dev
MYSQL_DATABASE=urbanflow

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_LANGUAGE=en
HEALTH_MAX_FORECAST_AGE_HOURS=24

# Forecast engine
DATA_VERSION=virtual-v1
FEATURE_VERSION=feature-v1
MODEL_VERSION=tcn-v1
MODEL_DIR=./models
DATASET_DIR=./data
URBANFLOW_LANGUAGE=en

# Optional, used only after the later integration stage
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=urbanflow-demand-forecast
